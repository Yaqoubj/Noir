<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/next_up_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical" android:background="#141416">
 <ImageView android:id="@+id/next_up_poster" android:layout_width="58dp" android:layout_height="86dp" android:scaleType="centerCrop" android:importantForAccessibility="no" />
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
  <TextView android:id="@+id/next_up_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#E4C084" android:letterSpacing="0.1" />
  <TextView android:id="@+id/next_up_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="#F6EEE2" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/next_up_episode" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E4C084" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/next_up_streak" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AEA79B" />
 </LinearLayout>
 <TextView android:id="@+id/next_up_check" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:textSize="28sp" android:textColor="#E4C084" android:background="#2E281F" />
</LinearLayout>
