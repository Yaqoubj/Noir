<resources><style name="NoirTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">false</item>
    <item name="android:colorAccent">#E4C084</item><item name="android:windowBackground">#0C0C0E</item>
    <item name="android:statusBarColor">#0C0C0E</item><item name="android:navigationBarColor">#0C0C0E</item>
    <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/NoirDialog</item>
</style>
<style name="NoirDialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
    <item name="android:textAllCaps">false</item><item name="android:textColor">#E4C084</item><item name="android:textSize">14sp</item><item name="android:minWidth">64dp</item>
</style>
<style name="NoirDialog" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/noir_dialog_bg</item><item name="android:colorAccent">#E4C084</item><item name="android:colorBackground">#161618</item>
    <item name="android:textColorPrimary">#F4F1EB</item><item name="android:textColorSecondary">#C7C2BC</item><item name="android:textColorAlertDialogListItem">#F4F1EB</item>
    <item name="android:buttonBarButtonStyle">@style/NoirDialogButton</item><item name="android:buttonBarPositiveButtonStyle">@style/NoirDialogButton</item><item name="android:buttonBarNegativeButtonStyle">@style/NoirDialogButton</item><item name="android:buttonBarNeutralButtonStyle">@style/NoirDialogButton</item>
</style>
</resources>
