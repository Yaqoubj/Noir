<Window x:Class="Noir.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 Title="Noir" Width="1320" Height="900" MinWidth="780" MinHeight="520" SizeChanged="Library_SizeChanged" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid>
  <Grid x:Name="LibraryRoot" Background="{StaticResource Ink}">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#101012" BorderBrush="#252527" BorderThickness="0,0,1,0">
    <DockPanel Margin="12,22,12,16">

     <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="LibraryCount" FontSize="12" Foreground="{StaticResource Muted}" Margin="14,0,0,16"/>
      <Button x:Name="DownloadsNav" Content="Downloads" HorizontalContentAlignment="Left" Click="Downloads_Click" Margin="0,0,0,4"/>
      <Button x:Name="ScanNav" Background="Transparent" HorizontalContentAlignment="Left" Click="Scan_Click" Margin="0,0,0,4"/>
      <Button x:Name="SettingsNav" Background="Transparent" HorizontalContentAlignment="Left" Click="Settings_Click"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="NOIR" Foreground="{StaticResource Text}" FontSize="28" FontWeight="Bold" Margin="15,0,0,3"/>
      <TextBlock Text="YOUR OWN CINEMA" FontSize="9" Foreground="#AAA49A" Margin="16,0,0,22"/>
      <Button x:Name="HomeNav" Content="⌂    Home" HorizontalContentAlignment="Left" Click="Home_Click" Margin="0,0,0,8"/>
      <Button x:Name="MovieNav" Content="▣    Movies" HorizontalContentAlignment="Left" Click="Movies_Click" Margin="0,0,0,8"/>
      <Button x:Name="ShowNav" Content="▤    Shows" HorizontalContentAlignment="Left" Click="Shows_Click" Margin="0,0,0,8"/>
      <Button x:Name="HistoryNav" Content="◷    History" HorizontalContentAlignment="Left" Click="History_Click" Margin="0,0,0,8"/>
      <Button x:Name="WatchlistNav" Content="+    My List" HorizontalContentAlignment="Left" Click="Watchlist_Click" Margin="0,0,0,8"/>
      <Button x:Name="DiscoverNav" Content="Discover" HorizontalContentAlignment="Left" Click="Discover_Click" Margin="0,0,0,8"/>
     </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <DockPanel x:Name="MainPane" Grid.Column="1" Margin="34,26,34,0">
    <Grid x:Name="LibraryHeader" DockPanel.Dock="Top" Margin="0,0,0,22">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="SearchColumn" Width="290"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="PageEyebrow" Text="LOCAL LIBRARY" FontSize="10" Foreground="{StaticResource Accent}"/><TextBlock x:Name="PageTitle" Foreground="{StaticResource Text}" Text="Your evening, queued." FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
     <Grid x:Name="SearchHost" Grid.Column="1" Height="38" VerticalAlignment="Center">
      <TextBox x:Name="SearchBox" ToolTip="Search your library" TextChanged="Search_Changed" AutomationProperties.Name="Search library"/>
      <TextBlock x:Name="SearchPlaceholder" Text="Search movies &amp; shows" Foreground="#817E78" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
    </Grid>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,15" TextWrapping="Wrap"/>
    <ScrollViewer x:Name="ContentScroll"><StackPanel x:Name="ContentPanel"/></ScrollViewer>
   </DockPanel>
  </Grid>
  <Grid x:Name="PlayerRoot" Background="Black" Visibility="Collapsed">
   <vlc:VideoView x:Name="Video" Background="Black" SizeChanged="Video_SizeChanged">
    <Grid x:Name="PlayerOverlay" Background="Transparent" MouseLeftButtonDown="Video_Click" MouseMove="Player_MouseMove">
   <Grid x:Name="PlayerHeader" VerticalAlignment="Top" Panel.ZIndex="10">
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F0101012" Offset="0"/><GradientStop Color="#A0101012" Offset="0.65"/><GradientStop Color="#00101012" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Content="←  Library" Click="Back_Click" Margin="18,14" Background="Transparent"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="NowTitle" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowEpisode" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="SleepButton" Visibility="Collapsed" Content="Sleep timer" Click="Sleep_Click"/><Button Content="Episodes" Click="PlayerEpisodes_Click" Margin="8,14,18,22" Background="Transparent"/></StackPanel>
   </Grid>
     <TextBlock x:Name="PlayerMessage" Foreground="{StaticResource Text}" Text="Opening video…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Background="#AA000000" Padding="20,10"/>
     <TextBlock x:Name="PlayerHint" Visibility="Collapsed" IsHitTestVisible="False" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,130" FontSize="15" Background="#BB101012" Padding="16,8"/>
     <Button x:Name="SkipIntro" Content="Skip intro  →" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,140" Visibility="Collapsed" Click="SkipIntro_Click" Style="{StaticResource Primary}"/>
     <Button x:Name="CreditsChip" Visibility="Collapsed" Content="Next episode ›" Click="CreditsChip_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,24,122" Background="#EE222224"/>
     <Border x:Name="NextPanel" Visibility="Collapsed" Background="#EE171719" BorderBrush="#494139" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,24,122" Padding="16" Width="290">
      <StackPanel><TextBlock Text="UP NEXT" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock x:Name="NextTitle" Foreground="{StaticResource Text}" FontSize="18" TextWrapping="Wrap" Margin="0,8,0,7"/><TextBlock x:Name="NextCountdown" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Play now" Click="NextNow_Click" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button Content="Cancel" Click="CancelNext_Click"/></StackPanel></StackPanel>
     </Border>
   <StackPanel x:Name="PlayerFooter" VerticalAlignment="Bottom" Panel.ZIndex="10">
    <StackPanel.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00101012" Offset="0"/><GradientStop Color="#D0101012" Offset="0.3"/><GradientStop Color="#F0101012" Offset="1"/></LinearGradientBrush></StackPanel.Background>
    <Grid Margin="24,15,24,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Elapsed" Foreground="{StaticResource Text}" Text="0:00" VerticalAlignment="Center"/>
     <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" Thumb.DragCompleted="Seek_DragCompleted" MouseMove="Seek_Preview" MouseLeave="Seek_Leave" VerticalAlignment="Center" AutomationProperties.Name="Playback position"/>
     <TextBlock x:Name="Total" Foreground="{StaticResource Text}" Grid.Column="2" Text="0:00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Margin="24,0,24,17">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Style="{StaticResource Primary}" MinWidth="92"/>
     <Button Grid.Column="1" Content="−10s" Click="Rewind_Click" Margin="8,0,0,0"/>
     <Button Grid.Column="2" Content="+10s" Click="Forward_Click" Margin="8,0,0,0"/>
     <StackPanel x:Name="PlayerVolume" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Volume" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Slider x:Name="VolumeBar" Minimum="0" Maximum="100" Width="70" Value="75" ValueChanged="Volume_Changed" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Volume"/></StackPanel>
     <TextBlock x:Name="SavedLabel" Visibility="Collapsed" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C7C2BC" FontSize="11" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Column="5" Content="Audio &amp; subtitles" Click="Languages_Click" Margin="8,0,0,0" Background="Transparent"/>
     <Button Grid.Column="6" Content="More" Click="PlayerMore_Click" Margin="8,0,0,0" Background="Transparent"/>
     <Button x:Name="PictureModeButton" Visibility="Collapsed" Grid.Column="7" Content="Fill" Click="PictureMode_Click"/>
     <Button Grid.Column="8" AutomationProperties.Name="Fullscreen" Click="Fullscreen_Click" ToolTip="Fullscreen (F)" Margin="8,0,0,0" Background="Transparent"><Viewbox Width="22" Height="22"><Path Stroke="#F4F1EB" StrokeThickness="1.6" Data="M1,8 L1,1 L8,1 M16,1 L23,1 L23,8 M23,16 L23,23 L16,23 M8,23 L1,23 L1,16"/></Viewbox></Button>
    </Grid>
   </StackPanel>
    </Grid>
   </vlc:VideoView>
  </Grid>
 </Grid>
</Window>
