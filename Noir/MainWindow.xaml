<Window x:Class="Noir.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 Title="Noir" Width="1320" Height="900" MinWidth="780" MinHeight="520" SizeChanged="Library_SizeChanged" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" FontFamily="Segoe UI Variable Text, Segoe UI" Background="{StaticResource Ink}" WindowStartupLocation="Manual" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid>
  <Grid x:Name="LibraryRoot" Background="{StaticResource Ink}">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="{DynamicResource Density.Sidebar}"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <!-- Side rail: the page list with icons, the profile card and the language switch. Arabic mirrors it to the right. -->
   <Border x:Name="SideRail" Background="#0E0E10" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Height="{DynamicResource Density.TopBar}" Margin="22,0,14,0">
      <TextBlock x:Name="RailLogo" Text="N O I R" Foreground="{StaticResource Accent}" FontSize="21" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Logo_Click" ToolTip="Home"/>
     </Grid>
     <StackPanel x:Name="RailFooter" DockPanel.Dock="Bottom" Margin="12,8,12,16"/>
     <ScrollViewer x:Name="NavScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
      <Grid x:Name="NavSurface">
      <StackPanel x:Name="NavLinks" Margin="12,4,12,8">
       <Button x:Name="HomeNav" Style="{StaticResource SideNav}" Click="Home_Click" AutomationProperties.Name="Home"/>
       <Button x:Name="DiscoverNav" Style="{StaticResource SideNav}" Click="Discover_Click" AutomationProperties.Name="Discover"/>
       <Button x:Name="ShowNav" Style="{StaticResource SideNav}" Click="Shows_Click" AutomationProperties.Name="Shows"/>
       <Button x:Name="MovieNav" Style="{StaticResource SideNav}" Click="Movies_Click" AutomationProperties.Name="Movies"/>
       <Button x:Name="WatchlistNav" Style="{StaticResource SideNav}" Click="Watchlist_Click" AutomationProperties.Name="My List"/>
       <Border x:Name="NavDivider" Height="1" Background="#14FFFFFF" Margin="12,12,12,12"/>
       <Button x:Name="HistoryNav" Style="{StaticResource SideNav}" Click="History_Click" AutomationProperties.Name="History"/>
       <Button x:Name="UpcomingNav" Style="{StaticResource SideNav}" Click="Upcoming_Click" AutomationProperties.Name="Upcoming"/>
       <Button x:Name="DownloadsNav" Style="{StaticResource SideNav}" Click="Downloads_Click" AutomationProperties.Name="Downloads"/>
       <Button x:Name="SettingsNav" Style="{StaticResource SideNav}" Click="Settings_Click" AutomationProperties.Name="Settings"/>
      </StackPanel>
      <Border x:Name="NavIndicator" Width="3" Height="24" CornerRadius="1.5" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0" IsHitTestVisible="False" Opacity="0"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
      </Grid>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1">
    <Border x:Name="PageAmbient" IsHitTestVisible="False"/>
    <!-- Full-width content. Cinematic pages put their hero under the floating top bar. -->
    <ScrollViewer x:Name="ContentScroll" ScrollChanged="Content_ScrollChanged">
     <StackPanel x:Name="PageBody">
      <StackPanel x:Name="LibraryHeader" Margin="56,108,56,10">
       <TextBlock x:Name="PageEyebrow" Text="LOCAL LIBRARY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
       <TextBlock x:Name="PageTitle" Foreground="{StaticResource Text}" Text="Your evening, queued." FontSize="{DynamicResource Density.PageTitle}" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel x:Name="ContentPanel" Margin="56,0,56,56"/>
     </StackPanel>
    </ScrollViewer>
    <!-- Floating top bar: a centred search pill over the artwork, solid once the page scrolls. -->
    <Grid x:Name="TopBar" VerticalAlignment="Top" Height="{DynamicResource Density.TopBar}">
     <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B30B0B0D" Offset="0"/><GradientStop Color="#000B0B0D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Border x:Name="TopBarFill" Background="#FF0D0D0F" Opacity="0" IsHitTestVisible="False" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1"/>
     <Grid x:Name="TopBarContent" Margin="36,0,28,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="RailToggle" Style="{StaticResource TopIcon}" Click="RailToggle_Click" ToolTip="Show or hide labels" AutomationProperties.Name="Toggle side menu" Margin="0"/>
      <Grid x:Name="SearchHost" Grid.Column="1" Width="420" Height="{DynamicResource Density.Search}" HorizontalAlignment="Center">
       <TextBox x:Name="SearchBox" Style="{StaticResource SearchPill}" ToolTip="Search your library" TextChanged="Search_Changed" AutomationProperties.Name="Search library"/>
       <Path x:Name="SearchGlyph" Data="M10,1 A9,9 0 1 1 9.99,1 M16.5,16.5 L23,23" Stroke="#B8B2AA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="16,0,0,0" IsHitTestVisible="False"/>
       <TextBlock x:Name="SearchPlaceholder" Text="Search movies &amp; shows" Foreground="#8F8A83" FontSize="13.5" Margin="44,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Grid x:Name="DownloadsTopHost" Visibility="{Binding Visibility,ElementName=DownloadsNav}"><Button x:Name="DownloadsTop" Style="{StaticResource TopIcon}" Click="DownloadsTop_Click" Visibility="Collapsed" ToolTip="Downloads" AutomationProperties.Name="Downloads"/></Grid><Button x:Name="HelpNav" Style="{StaticResource TopIcon}" Click="Help_Click" ToolTip="Shortcuts &amp; tips (?)" AutomationProperties.Name="Shortcuts and tips"><TextBlock Text="?" FontSize="17" FontWeight="SemiBold" Foreground="#D9D4CC"/></Button><Button x:Name="ScanNav" Style="{StaticResource TopIcon}" Click="Scan_Click" ToolTip="Scan library for new files" AutomationProperties.Name="Scan library"/></StackPanel>
     </Grid>
    </Grid>
    <!-- Status messages float briefly at the bottom instead of occupying a line. -->
    <Border x:Name="StatusToast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,26" Padding="18,10" CornerRadius="20" Background="#F21C1C1F" BorderBrush="#33E4C084" BorderThickness="1" Opacity="0" IsHitTestVisible="False" MaxWidth="720">
     <TextBlock x:Name="Status" Foreground="#E9E4DC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
    <TextBlock x:Name="LibraryCount" Visibility="Collapsed"/>
   </Grid>
  </Grid>
  <Grid x:Name="PlayerRoot" Background="Black" Visibility="Collapsed">
   <!-- Built on first use (PlayerSurface.cs) so startup skips the hidden player. -->
   <Grid.Resources><ControlTemplate x:Key="PlayerSurface" TargetType="ContentControl">
   <vlc:VideoView x:Name="Video" Background="Black" SizeChanged="Video_SizeChanged">
    <Grid x:Name="PlayerOverlay" Background="Transparent" MouseLeftButtonDown="Video_Click" MouseMove="Player_MouseMove">
   <Grid x:Name="PlayerHeader" VerticalAlignment="Top" Panel.ZIndex="10">
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F0101012" Offset="0"/><GradientStop Color="#A0101012" Offset="0.65"/><GradientStop Color="#00101012" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="PlayerBackButton" Content="[[back]]  Library" Click="Back_Click" Margin="18,14" Background="Transparent" ToolTip="Back to the library (Esc)"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="NowTitle" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowEpisode" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="SleepButton" Visibility="Collapsed" Content="Sleep timer" Click="Sleep_Click"/><Button x:Name="PlayerEpisodesButton" Content="Episodes" Click="PlayerEpisodes_Click" Margin="8,14,18,22" Background="Transparent" ToolTip="Every episode of this show"/></StackPanel>
   </Grid>
     <TextBlock x:Name="PlayerMessage" Foreground="{StaticResource Text}" Text="Opening video…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Background="#AA000000" Padding="20,10"/>
     <TextBlock x:Name="PlayerHint" Visibility="Collapsed" IsHitTestVisible="False" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,130" FontSize="15" Background="#BB101012" Padding="16,8"/>
     <Button x:Name="SkipIntro" Content="Skip intro  [[forward]]" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,140" Visibility="Collapsed" Click="SkipIntro_Click" Style="{StaticResource Primary}" ToolTip="Press I to skip a known intro"/>
     <Button x:Name="CreditsChip" Visibility="Collapsed" Content="Next episode  [[chevron]]" Click="CreditsChip_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,24,122" Background="#EE222224"/>
     <!-- Up Next card: episode still in a reserved 16:9 box, ring countdown around the play button. -->
     <Border x:Name="NextPanel" Visibility="Collapsed" Background="#F2161618" BorderBrush="#4D453B" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,28,122" Width="352" Panel.ZIndex="12">
      <StackPanel>
       <Grid x:Name="NextMedia" Height="198" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="NextNow_Click">
        <Border x:Name="NextStill" Background="#1E1E21" CornerRadius="11,11,0,0"/>
        <Border CornerRadius="11,11,0,0" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00161618" Offset="0.45"/><GradientStop Color="#F2161618" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <Grid x:Name="NextRingHost" Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Ellipse Stroke="#55FFFFFF" StrokeThickness="3" Fill="#99101012"/>
         <Path x:Name="NextRing" Stroke="{StaticResource Accent}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
         <Button x:Name="NextRingPlay" Click="NextNow_Click" Style="{StaticResource PlayerRound}" Width="50" Height="50" AutomationProperties.Name="Play next now"><Path Data="M5,2 L21,12 L5,22 Z" Fill="#16120C" Width="16" Height="16" Stretch="Uniform" Margin="3,0,0,0"/></Button>
        </Grid>
       </Grid>
       <StackPanel Margin="18,12,18,16"><TextBlock x:Name="NextLabel" Text="UP NEXT" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="NextTitle" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,5"/><TextBlock x:Name="NextCountdown" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><Button x:Name="NextPlay" Content="Play now" Click="NextNow_Click" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="NextCancel" Content="Cancel" Click="CancelNext_Click"/></StackPanel></StackPanel>
      </StackPanel>
     </Border>
     <Border x:Name="StillWatchingPanel" Visibility="Collapsed" Background="#F5141416" BorderBrush="#4D453B" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,28" MaxWidth="460" Panel.ZIndex="20">
      <StackPanel><TextBlock x:Name="StillWatchingTitle" Foreground="{StaticResource Text}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/><TextBlock x:Name="StillWatchingBody" Foreground="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="StillWatchingContinue" Content="Continue watching" Click="StillWatchingContinue_Click" Style="{StaticResource Primary}" Margin="0,0,12,0"/><Button x:Name="StillWatchingBack" Content="Back to Noir" Click="Back_Click"/></StackPanel></StackPanel>
     </Border>
   <StackPanel x:Name="PlayerFooter" VerticalAlignment="Bottom" Panel.ZIndex="10">
    <StackPanel.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00101012" Offset="0"/><GradientStop Color="#D0101012" Offset="0.3"/><GradientStop Color="#F0101012" Offset="1"/></LinearGradientBrush></StackPanel.Background>
    <Grid Margin="24,15,24,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Elapsed" Foreground="{StaticResource Text}" Text="0:00" VerticalAlignment="Center" FontSize="13"/>
     <Grid Grid.Column="1" VerticalAlignment="Center"><Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" Thumb.DragCompleted="Seek_DragCompleted" MouseMove="Seek_Preview" MouseLeave="Seek_Leave" SizeChanged="SeekBar_SizeChanged" VerticalAlignment="Center" AutomationProperties.Name="Playback position"/><Canvas x:Name="ChapterTicks" IsHitTestVisible="False" VerticalAlignment="Center" Height="5"/></Grid>
     <TextBlock x:Name="Total" Foreground="{StaticResource Text}" Grid.Column="2" Text="0:00" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Cursor="Hand" ToolTip="Switch between time left and length" MouseLeftButtonDown="Total_Click"/>
    </Grid>
    <Grid Margin="24,2,24,18">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PauseButton" Click="Pause_Click" Style="{StaticResource PlayerRound}" ToolTip="Pause (Space)" AutomationProperties.Name="Pause"><Path Data="M3,1 L9,1 L9,23 L3,23 Z M15,1 L21,1 L21,23 L15,23 Z" Fill="#16120C" Width="18" Height="18" Stretch="Uniform"/></Button>
     <Button Grid.Column="1" Click="Rewind_Click" Style="{StaticResource PlayerIcon}" Margin="10,0,0,0" ToolTip="Back 10 seconds (←)" AutomationProperties.Name="Back 10 seconds"><Grid Width="30" Height="30"><Path Data="M15,4 A11,11 0 1 0 26,15 M15,4 L20,0.5 M15,4 L20,7.5" Stroke="#F4F1EB" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="10" FontSize="10" FontWeight="SemiBold" Foreground="#F4F1EB" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/></Grid></Button>
     <Button Grid.Column="2" Click="Forward_Click" Style="{StaticResource PlayerIcon}" Margin="2,0,0,0" ToolTip="Forward 10 seconds (→)" AutomationProperties.Name="Forward 10 seconds"><Grid Width="30" Height="30"><Path Data="M15,4 A11,11 0 1 1 4,15 M15,4 L10,0.5 M15,4 L10,7.5" Stroke="#F4F1EB" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="10" FontSize="10" FontWeight="SemiBold" Foreground="#F4F1EB" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/></Grid></Button>
     <StackPanel x:Name="PlayerVolume" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Volume (↑ ↓ · M to mute)" MouseEnter="PlayerVolume_MouseEnter" MouseLeave="PlayerVolume_MouseLeave"><Button x:Name="MuteButton" Click="Mute_Click" Style="{StaticResource PlayerIcon}" AutomationProperties.Name="Mute"><Path x:Name="VolumeIcon" Data="M1,8 L6,8 L12,3 L12,21 L6,16 L1,16 Z M16,8.5 A5,5 0 0 1 16,15.5 M19,5 A10,10 0 0 1 19,19" Stroke="#F4F1EB" StrokeThickness="1.6" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/></Button><Slider x:Name="VolumeBar" Minimum="0" Maximum="100" Width="84" Value="75" ValueChanged="Volume_Changed" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Volume"/></StackPanel>
     <TextBlock x:Name="SavedLabel" Visibility="Collapsed" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C7C2BC" FontSize="11" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Column="5" Click="Languages_Click" Style="{StaticResource PlayerIcon}" ToolTip="Audio, subtitles &amp; timing ([ ] shifts subtitles)" AutomationProperties.Name="Audio and subtitles"><Grid Width="30" Height="22"><Border BorderBrush="#F4F1EB" BorderThickness="1.6" CornerRadius="4"/><TextBlock Text="CC" FontSize="10.5" FontWeight="Bold" Foreground="#F4F1EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
     <Button Grid.Column="6" Click="PlayerMore_Click" Style="{StaticResource PlayerIcon}" Margin="4,0,0,0" ToolTip="More: picture, sleep timer, intro times, shortcuts (?)" AutomationProperties.Name="More"><Path Data="M1,5 L23,5 M1,12 L23,12 M1,19 L23,19 M7,2 L7,8 M17,9 L17,15 M10,16 L10,22" Stroke="#F4F1EB" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform"/></Button>
     <Button x:Name="PictureModeButton" Visibility="Collapsed" Grid.Column="7" Content="Fill" Click="PictureMode_Click"/>
     <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BoostButton" Visibility="Collapsed" Content="Boost" Click="Boost_Click" Background="Transparent" Padding="10,6" Margin="4,0,0,0" FontSize="12" ToolTip="Volume boost: up to 200% for quiet videos" AutomationProperties.Name="Volume boost"/><Button x:Name="SpeedButton" Content="1×" Click="Speed_Click" Background="Transparent" Padding="10,6" Margin="2,0,0,0" FontSize="13" FontWeight="SemiBold" ToolTip="Playback speed (Shift+&lt; slower · Shift+&gt; faster)" AutomationProperties.Name="Playback speed"/></StackPanel>
     <Button Grid.Column="8" AutomationProperties.Name="Fullscreen" Click="Fullscreen_Click" ToolTip="Fullscreen (F or double-click the video)" Margin="4,0,0,0" Style="{StaticResource PlayerIcon}"><Viewbox Width="22" Height="22"><Path Stroke="#F4F1EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,8 L1,1 L8,1 M16,1 L23,1 L23,8 M23,16 L23,23 L16,23 M8,23 L1,23 L1,16"/></Viewbox></Button>
    </Grid>
   </StackPanel>
    </Grid>
   </vlc:VideoView>
   </ControlTemplate></Grid.Resources>
  </Grid>
 </Grid>
</Window>
